<?xml version="1.0"?>
<form col="6">
    <label name="journal"/>
    <field name="journal"/>
    <label name="period"/>
    <field name="period"/>
    <label name="company"/>
    <field name="company"/>
    
    <label name="effective_date"/>
    <field name="effective_date"/>
    <label name="from_account"/>
    <field name="from_account"/>
    <newline/>
    
    <label name="description"/>
    <field name="description" colspan="5"/>
    
    <notebook colspan="6">
        <page id="lines" string="Expense Allocation">
            <field name="lines" colspan="4"/>
            <group col="2" colspan="4" id="total_group">
                <label name="total_amount"/>
                <field name="total_amount"/>
            </group>
        </page>
    </notebook>
    
    <group col="4" colspan="6" id="state_group">
        <label name="state"/>
        <field name="state"/>
        <button name="process_entry" string="POST PAYMENT" icon="tryton-ok"/>
    </group>
</form>