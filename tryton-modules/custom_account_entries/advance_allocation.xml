<?xml version="1.0"?>
<tryton>
    <data>
        <record model="ir.ui.view" id="view_advance_line_tree">
            <field name="model">account.move.line</field>
            <field name="type">tree</field>
            <field name="name">advance_line_tree</field>
        </record>

        <record model="ir.ui.view" id="advance_allocation_view_form">
            <field name="model">account.advance_allocation</field>
            <field name="type">form</field>
            <field name="name">advance_allocation_form</field>
        </record>
        
        <record model="ir.ui.view" id="advance_allocation_view_tree">
            <field name="model">account.advance_allocation</field>
            <field name="type">tree</field>
            <field name="name">advance_allocation_tree</field>
        </record>

        <record model="ir.action.act_window" id="act_advance_allocation_form">
            <field name="name">Advance Allocation</field>
            <field name="res_model">account.advance_allocation</field>
        </record>
        <record model="ir.action.act_window.view" id="act_advance_allocation_form_view1">
            <field name="sequence" eval="10"/>
            <field name="view" ref="advance_allocation_view_tree"/>
            <field name="act_window" ref="act_advance_allocation_form"/>
        </record>
        <record model="ir.action.act_window.view" id="act_advance_allocation_form_view2">
            <field name="sequence" eval="20"/>
            <field name="view" ref="advance_allocation_view_form"/>
            <field name="act_window" ref="act_advance_allocation_form"/>
        </record>

        <!-- Moved into Entries menu -->
        <menuitem
            parent="account.menu_entries"
            action="act_advance_allocation_form"
            sequence="50"
            id="menu_advance_allocation"/>
            
        <record model="ir.model.button" id="advance_allocation_allocate_button">
            <field name="model">account.advance_allocation</field>
            <field name="name">allocate</field>
            <field name="string">Bulk Recall Deposit</field>
        </record>

    </data>
</tryton>